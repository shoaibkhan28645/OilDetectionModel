  "cells": [
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "intro"
      },
      "source": [
        "# 🛢️ Oil Detection (Coriander vs Mustard) — Google Colab\n",
        "\n",
        "A clean, Colab-ready notebook that:\n",
        "- Mounts Google Drive (optional) and sets up folders\n",
        "- Prepares train/validation splits from a `oil_images/` ZIP\n",
        "- Builds MobileNetV2 transfer learning model\n",
        "- Trains with safe step calculations (prevents length 0 errors)\n",
        "- Evaluates with classification report + confusion matrix\n",
        "- Saves best model to `models/best_oil_detection_colab.h5`\n",
        "\n",
        "Tip: Enable GPU (Runtime → Change runtime type → GPU)."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "setup"
      },
      "source": [
        "# Environment setup and quick diagnostics\n",
        "import os, math, random, io, zipfile\n",
        "import numpy as np\n",
        "\n",
        "# Silence TF logs a bit\n",
        "os.environ.setdefault('TF_CPP_MIN_LOG_LEVEL', '2')\n",
        "\n",
        "# Ensure optional deps are available (cv2, seaborn, sklearn)\n",
        "try:\n",
        "    import cv2  # noqa: F401\n",
        "except Exception:\n",
        "    print('Installing OpenCV + visualization deps...')\n",
        "%pip -q install opencv-python-headless==4.10.0.84 seaborn scikit-learn\n",
        "    import cv2  # noqa: F401\n",
        "\n",
        "import tensorflow as tf\n",
        "import matplotlib.pyplot as plt\n",
        "import seaborn as sns\n",
        "\n",
        "print('TensorFlow :', tf.__version__)\n",
        "try:\n",
        "    import cv2\n",
        "    print('OpenCV     :', cv2.__version__)\n",
        "except Exception as e:\n",
        "    print('OpenCV     : not available', e)\n",
        "print('GPU devices:', tf.config.list_physical_devices('GPU'))\n",
        "\n",
        "# Seeds for reproducibility\n",
        "SEED = 42\n",
        "random.seed(SEED); np.random.seed(SEED); tf.random.set_seed(SEED)\n",
        "\n",
        "# Matplotlib defaults\n",
        "plt.rcParams['figure.facecolor'] = 'white'\n",
        "plt.rcParams['axes.grid'] = False\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "paths"
      },
      "source": [
        "# Paths and runtime options (edit BASE_DIR if using Drive)\n",
        "USE_DRIVE = True  # Set False to use Colab ephemeral storage\n",
        "\n",
        "if USE_DRIVE:\n",
        "    from google.colab import drive\n",
        "    drive.mount('/content/drive')\n",
        "    # TODO: Update this to your Drive project folder if different\n",
        "    BASE_DIR = '/content/drive/MyDrive/OilDetectionModel'\n",
        "else:\n",
        "    BASE_DIR = '/content'\n",
        "\n",
        "DATA_DIR = os.path.join(BASE_DIR, 'data')\n",
        "SOURCE_DIR = os.path.join(DATA_DIR, 'source')  # expects coriander_oil/ and mustard_oil/ inside\n",
        "TRAIN_DIR = os.path.join(DATA_DIR, 'train')\n",
        "VAL_DIR = os.path.join(DATA_DIR, 'validation')\n",
        "MODEL_DIR = os.path.join(BASE_DIR, 'models')\n",
        "\n",
        "for d in [DATA_DIR, SOURCE_DIR, TRAIN_DIR, VAL_DIR, MODEL_DIR]:\n",
        "    os.makedirs(d, exist_ok=True)\n",
        "\n",
        "# Training config\n",
        "IMG_SIZE = (224, 224)\n",
        "BATCH_SIZE = 16\n",
        "EPOCHS = 25\n",
        "CLASSES = ['coriander_oil', 'mustard_oil']\n",
        "\n",
        "print('BASE_DIR  :', BASE_DIR)\n",
        "print('DATA_DIR  :', DATA_DIR)\n",
        "print('MODEL_DIR :', MODEL_DIR)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "upload_zip_md"
      },
      "source": [
        "## Upload your dataset ZIP (optional)\n",
        "Upload a ZIP with structure:\n",
        "\n",
        "```
oil_images.zip
├── coriander_oil/
│   ├── img1.jpg
│   └── ...
└── mustard_oil/
    ├── img1.jpg
    └── ...
```
",
        "It will be extracted to `data/source/`. If your `data/train/` and `data/validation/` are already filled, you can skip this."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "upload_zip"
      },
      "source": [
        "from pathlib import Path\n",
        "try:\n",
        "    from google.colab import files as colab_files\n",
        "    print('Upload oil_images.zip or click \'Cancel\' to skip...')\n",
        "    uploaded = colab_files.upload()\n",
        "    for name, content in uploaded.items():\n",
        "        if name.lower().endswith('.zip'):\n",
        "            zf = zipfile.ZipFile(io.BytesIO(content))\n",
        "            zf.extractall(SOURCE_DIR)\n",
        "            print(f'Extracted {name} to {SOURCE_DIR}')\n",
        "except Exception as e:\n",
        "    print('Colab file upload not available or skipped:', e)\n",
        "\n",
        "# Show a quick tree of source dir\n",
        "for root, dirs, files in os.walk(SOURCE_DIR):\n",
        "    level = root.replace(SOURCE_DIR, '').count(os.sep)\n",
        "    indent = '  ' * level\n",
        "    print(f\"{indent}{os.path.basename(root)}/\")\n",
        "    subindent = '  ' * (level + 1)\n",
        "    for f in files[:3]:\n",
        "        print(f\"{subindent}{f}\")\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "helpers"
      },
      "source": [
        "# Core classes and helpers (mirrors repo src/)\n",
        "import shutil\n",
        "from sklearn.model_selection import train_test_split\n",
        "from sklearn.metrics import classification_report, confusion_matrix\n",
        "from tensorflow.keras.preprocessing.image import ImageDataGenerator\n",
        "\n",
        "class OilDataPreprocessor:\n",
        "    def __init__(self, img_size=(224, 224), batch_size=32):\n",
        "        self.img_size = img_size\n",
        "        self.batch_size = batch_size\n",
        "        self.classes = ['coriander_oil', 'mustard_oil']\n",
        "\n",
        "    def create_data_generators(self, train_dir, validation_dir):\n",
        "        train_datagen = ImageDataGenerator(\n",
        "            rescale=1./255,\n",
        "            rotation_range=20,\n",
        "            width_shift_range=0.2,\n",
        "            height_shift_range=0.2,\n",
        "            shear_range=0.2,\n",
        "            zoom_range=0.2,\n",
        "            horizontal_flip=True,\n",
        "            brightness_range=[0.8, 1.2],\n",
        "            fill_mode='nearest'\n",
        "        )\n",
        "        val_datagen = ImageDataGenerator(rescale=1./255)\n",
        "\n",
        "        train_gen = train_datagen.flow_from_directory(\n",
        "            train_dir,\n",
        "            target_size=self.img_size,\n",
        "            batch_size=self.batch_size,\n",
        "            class_mode='binary',\n",
        "            classes=self.classes\n",
        "        )\n",
        "        val_gen = val_datagen.flow_from_directory(\n",
        "            validation_dir,\n",
        "            target_size=self.img_size,\n",
        "            batch_size=self.batch_size,\n",
        "            class_mode='binary',\n",
        "            classes=self.classes,\n",
        "            shuffle=False\n",
        "        )\n",
        "        return train_gen, val_gen\n",
        "\n",
        "def prepare_data_split(source_dir, train_dir, val_dir, val_split=0.2):\n",
        "    for class_name in ['coriander_oil', 'mustard_oil']:\n",
        "        src_class_dir = os.path.join(source_dir, class_name)\n",
        "        if not os.path.isdir(src_class_dir):\n",
        "            print(f'Warning: {src_class_dir} missing')\n",
        "            continue\n",
        "        images = [f for f in os.listdir(src_class_dir) if f.lower().endswith(('.png','.jpg','.jpeg'))]\n",
        "        if not images:\n",
        "            print(f'No images in {src_class_dir}')\n",
        "            continue\n",
        "        train_imgs, val_imgs = train_test_split(images, test_size=val_split, random_state=42)\n",
        "        tdir = os.path.join(train_dir, class_name)\n",
        "        vdir = os.path.join(val_dir, class_name)\n",
        "        os.makedirs(tdir, exist_ok=True); os.makedirs(vdir, exist_ok=True)\n",
        "        for img in train_imgs:\n",
        "            s = os.path.join(src_class_dir, img); d = os.path.join(tdir, img)\n",
        "            if not os.path.exists(d): shutil.copy2(s, d)\n",
        "        for img in val_imgs:\n",
        "            s = os.path.join(src_class_dir, img); d = os.path.join(vdir, img)\n",
        "            if not os.path.exists(d): shutil.copy2(s, d)\n",
        "        print(f\"{class_name}: {len(train_imgs)} train, {len(val_imgs)} val\")\n",
        "\n",
        "import tensorflow as tf\n",
        "from tensorflow.keras.applications import MobileNetV2\n",
        "from tensorflow.keras.layers import Dense, GlobalAveragePooling2D, Dropout\n",
        "from tensorflow.keras.models import Model\n",
        "from tensorflow.keras.optimizers import Adam\n",
        "from tensorflow.keras.callbacks import EarlyStopping, ModelCheckpoint, ReduceLROnPlateau\n",
        "\n",
        "class OilDetectionModel:\n",
        "    def __init__(self, img_size=(224,224), num_classes=1):\n",
        "        self.img_size = img_size + (3,)\n",
        "        self.num_classes = num_classes\n",
        "        self.model = None\n",
        "\n",
        "    def create_transfer_learning_model(self, learning_rate=0.001):\n",
        "        base = MobileNetV2(weights='imagenet', include_top=False, input_shape=self.img_size)\n",
        "        base.trainable = False\n",
        "        inputs = tf.keras.Input(shape=self.img_size)\n",
        "        x = base(inputs, training=False)\n",
        "        x = GlobalAveragePooling2D()(x)\n",
        "        x = Dropout(0.2)(x)\n",
        "        if self.num_classes == 1:\n",
        "            outputs = Dense(1, activation='sigmoid', name='predictions')(x)\n",
        "            loss = 'binary_crossentropy'\n",
        "        else:\n",
        "            outputs = Dense(self.num_classes, activation='softmax', name='predictions')(x)\n",
        "            loss = 'categorical_crossentropy'\n",
        "        model = Model(inputs, outputs)\n",
        "        model.compile(optimizer=Adam(learning_rate=learning_rate), loss=loss, metrics=['accuracy'])\n",
        "        self.model = model\n",
        "        return model\n",
        "\n",
        "    def get_callbacks(self, model_save_path):\n",
        "        return [\n",
        "            EarlyStopping(monitor='val_loss', patience=10, restore_best_weights=True),\n",
        "            ModelCheckpoint(model_save_path, monitor='val_loss', save_best_only=True, save_weights_only=False),\n",
        "            ReduceLROnPlateau(monitor='val_loss', factor=0.2, patience=5, min_lr=1e-4),\n",
        "        ]\n",
        "\n",
        "    def plot_training_history(self, history):\n",
        "        acc = history.history.get('accuracy', [])\n",
        "        val_acc = history.history.get('val_accuracy', [])\n",
        "        loss = history.history.get('loss', [])\n",
        "        val_loss = history.history.get('val_loss', [])\n",
        "        epochs = range(len(acc))\n",
        "        plt.figure(figsize=(12,4))\n",
        "        plt.subplot(1,2,1); plt.plot(epochs, acc, label='train'); plt.plot(epochs, val_acc, label='val'); plt.title('Accuracy'); plt.legend()\n",
        "        plt.subplot(1,2,2); plt.plot(epochs, loss, label='train'); plt.plot(epochs, val_loss, label='val'); plt.title('Loss'); plt.legend()\n",
        "        plt.tight_layout(); plt.show()\n",
        "\n",
        "def compute_steps(num_samples, batch_size):\n",
        "    return max(1, math.ceil(num_samples / max(1, batch_size)))\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "split_data"
      },
      "source": [
        "# If train/val are empty but source exists, create an 80/20 split\n",
        "def count_images(d):\n",
        "    total = 0\n",
        "    for cname in CLASSES:\n",
        "        cdir = os.path.join(d, cname)\n",
        "        if os.path.isdir(cdir):\n",
        "            total += len([f for f in os.listdir(cdir) if f.lower().endswith(('.jpg','.jpeg','.png'))])\n",
        "    return total\n",
        "\n",
        "train_count = count_images(TRAIN_DIR)\n",
        "val_count = count_images(VAL_DIR)\n",
        "src_count = count_images(SOURCE_DIR)\n",
        "print('Images — source:', src_count, '| train:', train_count, '| val:', val_count)\n",
        "\n",
        "if src_count > 0 and (train_count == 0 or val_count == 0):\n",
        "    print('Creating train/validation split from source...')\n",
        "    prepare_data_split(SOURCE_DIR, TRAIN_DIR, VAL_DIR, val_split=0.2)\n",
        "    train_count = count_images(TRAIN_DIR)\n",
        "    val_count = count_images(VAL_DIR)\n",
        "    print('Done. Train:', train_count, 'Val:', val_count)\n",
        "\n",
        "assert train_count > 0, 'No training images found. Ensure data/train/{coriander_oil,mustard_oil} exist.'\n",
        "assert val_count > 0, 'No validation images found. Ensure data/validation/{coriander_oil,mustard_oil} exist.'\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "generators"
      },
      "source": [
        "# Build data generators\n",
        "pre = OilDataPreprocessor(img_size=IMG_SIZE, batch_size=BATCH_SIZE)\n",
        "train_generator, val_generator = pre.create_data_generators(TRAIN_DIR, VAL_DIR)\n",
        "\n",
        "print('Train samples     :', train_generator.samples)\n",
        "print('Validation samples:', val_generator.samples)\n",
        "print('Class indices     :', train_generator.class_indices)\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "build_model"
      },
      "source": [
        "# Create model and callbacks\n",
        "oil_model = OilDetectionModel(img_size=IMG_SIZE)\n",
        "model = oil_model.create_transfer_learning_model()\n",
        "model_path = os.path.join(MODEL_DIR, 'best_oil_detection_colab.h5')\n",
        "callbacks = oil_model.get_callbacks(model_path)\n",
        "model.summary()\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "train"
      },
      "source": [
        "# Train with safe step calculations (prevents \"length 0\" errors)\n",
        "steps_per_epoch = compute_steps(train_generator.samples, BATCH_SIZE)\n",
        "val_steps = compute_steps(val_generator.samples, BATCH_SIZE)\n",
        "print('steps_per_epoch   :', steps_per_epoch)\n",
        "print('validation_steps  :', val_steps)\n",
        "\n",
        "history = model.fit(\n",
        "    train_generator,\n",
        "    epochs=EPOCHS,\n",
        "    steps_per_epoch=steps_per_epoch,\n",
        "    validation_data=val_generator,\n",
        "    validation_steps=val_steps,\n",
        "    callbacks=callbacks,\n",
        "    verbose=1\n",
        ")\n",
        "print('Training complete.')\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "evaluate"
      },
      "source": [
        "# Evaluate, show metrics + confusion matrix\n",
        "val_loss, val_acc = model.evaluate(val_generator, verbose=0)\n",
        "print(f'Validation Loss: {val_loss:.4f}')\n",
        "print(f'Validation Acc : {val_acc:.4f}')\n",
        "\n",
        "pred = model.predict(val_generator, verbose=0)\n",
        "y_pred = (pred > 0.5).astype(int).reshape(-1)\n",
        "y_true = val_generator.classes\n",
        "class_names = list(val_generator.class_indices.keys())\n",
        "\n",
        "print('\nClassification Report:')\n",
        "print(classification_report(y_true, y_pred, target_names=class_names))\n",
        "\n",
        "cm = confusion_matrix(y_true, y_pred)\n",
        "plt.figure(figsize=(6,5))\n",
        "sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=class_names, yticklabels=class_names)\n",
        "plt.title('Confusion Matrix')\n",
        "plt.ylabel('True')\n",
        "plt.xlabel('Pred')\n",
        "plt.show()\n",
        "\n",
        "# Plot curves\n",
        "oil_model.plot_training_history(history)\n",
        "print('Best model saved to:', model_path)\n"
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "download_model"
      },
      "source": [
        "# Download the best model (optional)\n",
        "try:\n",
        "    from google.colab import files as colab_files\n",
        "    colab_files.download(model_path)\n",
        "except Exception as e:\n",
        "    print('Download skipped:', e)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "predict_md"
      },
      "source": [
        "## Predict on your own image (optional)\n",
        "Upload an image, then run the prediction cell."
      ]
    },
    {
      "cell_type": "code",
      "metadata": {
        "id": "predict"
      },
      "source": [
        "from tensorflow.keras.preprocessing import image as keras_image\n",
        "\n",
        "def load_image_for_model(img_path, target_size=IMG_SIZE):\n",
        "    import cv2\n",
        "    img = cv2.imread(img_path)\n",
        "    if img is None:\n",
        "        raise ValueError(f'Cannot read image: {img_path}')\n",
        "    img = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n",
        "    img = cv2.resize(img, target_size).astype('float32') / 255.0\n",
        "    return np.expand_dims(img, axis=0)\n",
        "\n",
        "try:\n",
        "    from google.colab import files as colab_files\n",
        "    print('Upload an image to predict...')\n",
        "    up = colab_files.upload()\n",
        "    for name, content in up.items():\n",
        "        with open(name, 'wb') as f:\n",
        "            f.write(content)\n",
        "        arr = load_image_for_model(name, IMG_SIZE)\n",
        "        prob = float(model.predict(arr, verbose=0)[0][0])\n",
        "        label = 'mustard_oil' if prob >= 0.5 else 'coriander_oil'\n",
        "        conf = prob if label=='mustard_oil' else 1.0 - prob\n",
        "        print(f'Predicted: {label} (confidence {conf:.2%})')\n",
        "        img = keras_image.load_img(name)\n",
        "        plt.imshow(img); plt.axis('off'); plt.title(f'{label} ({conf:.1%})'); plt.show()\n",
        "except Exception as e:\n",
        "    print('Prediction skipped:', e)\n"
      ]
    }
  ]
}

